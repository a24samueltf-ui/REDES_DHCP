{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [
        "eth0"
      ]
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea-leases4.csv",
      "lfc-interval": 1800,
      "max-row-errors": 100
    },
    "valid-lifetime": 600,
    "rebind-timer": 500,
    "authoritative": true,
    "renew-timer": 300,
    "subnet4": [
      {
        "id": 1,
        "subnet": "192.168.10.0/24",
        "pools": [
          {
            "pool": "192.168.10.30 - 192.168.10.32",
            "option-data": [
              { "name": "routers", "data": "192.168.10.253" },
              { "name": "domain-name-servers", "data": "stark.lan" }
            ]
          },
          {
            "pool": "192.168.10.101 - 192.168.10.230",
            "option-data": [
              { "name": "routers", "data": "192.168.10.254" },
              { "name": "domain-name-servers", "data": "stark.lan" }
            ]
          }
        ],
        "reservations": [
          {
            "hw-address": "02:42:ac:11:00:10",
            "ip-address": "192.168.10.30"
          }
        ]
      }
    ],
    "loggers": [
      {
        "name": "*",
        "severity": "DEBUG"
      }
    ]
  }
}